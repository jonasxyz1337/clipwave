{
  "name": "clipwave",
  "productName": "Clipwave",
  "version": "1.3.1",
  "description": "Vertical clip studio for TikTok, Shorts and Reels",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.clipwave.app",
    "productName": "Clipwave",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "artifactName": "Clipwave-Setup-${version}.exe",
      "uninstallDisplayName": "Clipwave",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Clipwave-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jonasxyz1337",
        "repo": "clipwave"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}